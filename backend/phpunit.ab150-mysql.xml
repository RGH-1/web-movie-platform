<?xml version="1.0" encoding="UTF-8" ?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <testsuite name="AB150 MySQL">
            <file>tests/Feature/AdminDashboardMySqlStressTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="ab150" force="true" />
        <env name="DB_CONNECTION" value="mysql" force="true" />
        <env
            name="DB_DATABASE"
            value="web_movie_platform_ab150_test"
            force="true"
        />
        <env name="DB_URL" value="" force="true" />
        <env name="CACHE_STORE" value="array" force="true" />
        <env name="MAIL_MAILER" value="array" force="true" />
        <env name="QUEUE_CONNECTION" value="sync" force="true" />
        <env name="SESSION_DRIVER" value="array" force="true" />
        <env name="AZURE_LANGUAGE_ENDPOINT" value="" force="true" />
        <env name="AZURE_LANGUAGE_KEY" value="" force="true" />
    </php>
</phpunit>
